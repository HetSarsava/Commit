# Server Configuration
NODE_ENV=development
PORT=5000

# Database Mode
# Set to 'true' to use mock in-memory data (no PostgreSQL needed)
# Set to 'false' to use real PostgreSQL database
USE_MOCK_DB=true

# Database (only needed if USE_MOCK_DB=false)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crm_db?schema=public"

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Redis (for job queues) - Optional
REDIS_URL=redis://localhost:6379

# Meta WhatsApp Cloud API (server only)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_GRAPH_API_VERSION=v25.0
WHATSAPP_DEFAULT_COUNTRY=IN
WHATSAPP_TIMEOUT_MS=10000
WHATSAPP_GATEWAY_PORT=5001
# Optional override for the durable demo store:
# WHATSAPP_DB_PATH=./data/whatsapp.sqlite

# Email Configuration (Nodemailer) - For later
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# AWS S3 (for file uploads) - Optional
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=your-bucket-name

# Or use local storage
UPLOAD_PATH=./uploads

# Client URL (Frontend)
CLIENT_URL=http://localhost:5173

# Company Details (for invoices/quotations)
COMPANY_NAME=Amit Uniform
COMPANY_GSTIN=
COMPANY_ADDRESS=
COMPANY_PHONE=
COMPANY_EMAIL=
BANK_NAME=State Bank of India (SBI)
BANK_ACCOUNT=43377408488
BANK_IFSC=SBIN0011768
BANK_BRANCH=I.O.C. Road, Chandkheda, Ahmedabad
