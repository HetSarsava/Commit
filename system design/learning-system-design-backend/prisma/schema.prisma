// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USERS & ROLES
// ============================================

enum UserRole {
  ADMIN
  SALES
  ACCOUNTS
  PRODUCTION
  PURCHASE
  MARKETING
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  name          String
  role          UserRole
  mobile        String?
  isActive      Boolean   @default(true)
  lastLogin     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  leads         Lead[]
  quotations    Quotation[]
  salesOrders   SalesOrder[]
  activities    Activity[]

  @@map("users")
  whatsappMessages WhatsappMessage[]
}

// ============================================
// LEADS & CRM
// ============================================

enum LeadSource {
  WEBSITE
  WHATSAPP
  GOOGLE_BUSINESS
  GOOGLE_ADS
  FACEBOOK
  INSTAGRAM
  INDIAMART
  JUSTDIAL
  TRADEINDIA
  ALIBABA
  EMAIL
  PHONE
  REFERRAL
  MANUAL
}

enum LeadStatus {
  NEW
  CONTACTED
  REQUIREMENT
  CATALOGUE
  QUOTATION
  NEGOTIATION
  SAMPLE
  ORDER
  PRODUCTION
  DISPATCH
  COMPLETED
  LOST
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
  HOT
}

model Lead {
  id              String        @id @default(uuid())

  // Company & Contact Details
  companyName     String
  contactPerson   String
  mobile          String
  whatsapp        String?
  email           String?
  city            String?
  state           String?

  // Business Details
  industry        String?
  requirement     String?
  productInterest String?
  quantity        Int?
  budget          Decimal?      @db.Decimal(12, 2)
  deliveryDate    DateTime?

  // CRM Fields
  source          LeadSource
  status          LeadStatus    @default(NEW)
  priority        LeadPriority  @default(MEDIUM)
  notes           String?       @db.Text
  followUpDate    DateTime?

  // Assignment
  salesPersonId   String?
  salesPerson     User?         @relation(fields: [salesPersonId], references: [id])

  // Timestamps
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  convertedAt     DateTime?

  // Relations
  customer        Customer?
  quotations      Quotation[]
  activities      Activity[]

  @@map("leads")
  @@index([status])
  @@index([salesPersonId])
  @@index([source])
  whatsappConversations WhatsappConversation[]
}

// ============================================
// CUSTOMERS
// ============================================

model Customer {
  id              String        @id @default(uuid())

  // Basic Details
  companyName     String
  contactPerson   String
  mobile          String
  whatsapp        String?
  email           String?

  // Address
  address         String?       @db.Text
  city            String?
  state           String?
  pincode         String?

  // Business Details
  gstin           String?       @unique
  industry        String?

  // CRM
  leadId          String?       @unique
  lead            Lead?         @relation(fields: [leadId], references: [id])

  // Timestamps
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  quotations      Quotation[]
  salesOrders     SalesOrder[]
  invoices        Invoice[]
  payments        Payment[]
  catalogues      CatalogueShare[]

  @@map("customers")
  whatsappConversations WhatsappConversation[]
}

// ============================================
// PRODUCTS & CATALOGUE
// ============================================

enum ProductCategory {
  UNIFORM
  SHIRT
  PANT
  JACKET
  ACCESSORIES
  OTHER
}

model Product {
  id              String          @id @default(uuid())

  // Product Details
  sku             String          @unique
  name            String
  description     String?         @db.Text
  category        ProductCategory

  // Specifications
  fabric          String?
  colors          String[]        // Array of available colors
  sizes           String[]        // Array of available sizes

  // Pricing
  moq             Int             // Minimum Order Quantity
  basePrice       Decimal         @db.Decimal(10, 2)

  // Images
  images          String[]        // Array of image URLs
  thumbnail       String?

  // Customization
  customizable    Boolean         @default(false)
  customizationOptions String?    @db.Text

  // Inventory
  stockQuantity   Int             @default(0)
  lowStockAlert   Int             @default(10)

  // Status
  isActive        Boolean         @default(true)

  // Timestamps
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Relations
  quotationItems  QuotationItem[]
  orderItems      OrderItem[]
  catalogueItems  CatalogueProduct[]
  inventoryLogs   InventoryLog[]

  @@map("products")
  @@index([category])
  @@index([isActive])
}

// ============================================
// CATALOGUE SYSTEM
// ============================================

model Catalogue {
  id              String            @id @default(uuid())

  name            String
  description     String?           @db.Text

  // Metadata
  requirementType String?
  targetAudience  String?

  // Files
  pdfUrl          String?
  shareableLink   String?           @unique

  // Timestamps
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Relations
  products        CatalogueProduct[]
  shares          CatalogueShare[]

  @@map("catalogues")
}

model CatalogueProduct {
  id            String      @id @default(uuid())

  catalogueId   String
  catalogue     Catalogue   @relation(fields: [catalogueId], references: [id], onDelete: Cascade)

  productId     String
  product       Product     @relation(fields: [productId], references: [id])

  displayOrder  Int         @default(0)

  @@unique([catalogueId, productId])
  @@map("catalogue_products")
}

model CatalogueShare {
  id            String      @id @default(uuid())

  catalogueId   String
  catalogue     Catalogue   @relation(fields: [catalogueId], references: [id])

  customerId    String
  customer      Customer    @relation(fields: [customerId], references: [id])

  // Analytics
  openedAt      DateTime?
  viewCount     Int         @default(0)
  lastViewedAt  DateTime?

  // Engagement
  productsViewed String[]   // Product IDs
  enquiryClicked Boolean    @default(false)

  createdAt     DateTime    @default(now())

  @@map("catalogue_shares")
  @@index([customerId])
}

// ============================================
// QUOTATIONS
// ============================================

enum QuotationStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
}

model Quotation {
  id              String          @id @default(uuid())

  quotationNumber String          @unique

  // Customer
  customerId      String
  customer        Customer        @relation(fields: [customerId], references: [id])

  // Lead Reference
  leadId          String?
  lead            Lead?           @relation(fields: [leadId], references: [id])

  // Sales Person
  salesPersonId   String
  salesPerson     User            @relation(fields: [salesPersonId], references: [id])

  // Status
  status          QuotationStatus @default(DRAFT)

  // Pricing
  subtotal        Decimal         @db.Decimal(12, 2)
  discountPercent Decimal?        @db.Decimal(5, 2)
  discountAmount  Decimal?        @db.Decimal(12, 2)
  taxAmount       Decimal         @db.Decimal(12, 2)
  total           Decimal         @db.Decimal(12, 2)

  // Terms
  termsConditions String?         @db.Text
  validUntil      DateTime
  notes           String?         @db.Text

  // Files
  pdfUrl          String?

  // Timestamps
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  sentAt          DateTime?

  // Relations
  items           QuotationItem[]
  salesOrder      SalesOrder?

  @@map("quotations")
  @@index([customerId])
  @@index([status])
}

model QuotationItem {
  id            String      @id @default(uuid())

  quotationId   String
  quotation     Quotation   @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  productId     String
  product       Product     @relation(fields: [productId], references: [id])

  // Details
  quantity      Int
  unitPrice     Decimal     @db.Decimal(10, 2)
  discount      Decimal?    @db.Decimal(10, 2)
  total         Decimal     @db.Decimal(12, 2)

  // Customization
  customization String?     @db.Text

  @@map("quotation_items")
}

// ============================================
// SALES ORDERS
// ============================================

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_PRODUCTION
  READY
  DISPATCHED
  DELIVERED
  CANCELLED
}

model SalesOrder {
  id              String        @id @default(uuid())

  orderNumber     String        @unique

  // Customer
  customerId      String
  customer        Customer      @relation(fields: [customerId], references: [id])

  // Quotation Reference
  quotationId     String?       @unique
  quotation       Quotation?    @relation(fields: [quotationId], references: [id])

  // Sales Person
  salesPersonId   String
  salesPerson     User          @relation(fields: [salesPersonId], references: [id])

  // Status
  status          OrderStatus   @default(PENDING)

  // Pricing
  subtotal        Decimal       @db.Decimal(12, 2)
  discountAmount  Decimal?      @db.Decimal(12, 2)
  taxAmount       Decimal       @db.Decimal(12, 2)
  shippingCharges Decimal?      @db.Decimal(10, 2)
  total           Decimal       @db.Decimal(12, 2)

  // Delivery
  expectedDelivery DateTime?
  actualDelivery   DateTime?

  // Notes
  notes           String?       @db.Text

  // Timestamps
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  confirmedAt     DateTime?

  // Relations
  items           OrderItem[]
  invoices        Invoice[]
  production      Production?

  @@map("sales_orders")
  @@index([customerId])
  @@index([status])
}

model OrderItem {
  id            String      @id @default(uuid())

  orderId       String
  order         SalesOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId     String
  product       Product     @relation(fields: [productId], references: [id])

  // Details
  quantity      Int
  unitPrice     Decimal     @db.Decimal(10, 2)
  discount      Decimal?    @db.Decimal(10, 2)
  total         Decimal     @db.Decimal(12, 2)

  // Customization
  customization String?     @db.Text

  @@map("order_items")
}

// ============================================
// INVOICES & BILLING
// ============================================

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  PARTIALLY_PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id              String        @id @default(uuid())

  invoiceNumber   String        @unique

  // Customer
  customerId      String
  customer        Customer      @relation(fields: [customerId], references: [id])

  // Order Reference
  orderId         String
  order           SalesOrder    @relation(fields: [orderId], references: [id])

  // Type
  isProforma      Boolean       @default(false)

  // Status
  status          InvoiceStatus @default(DRAFT)

  // GST Details
  gstin           String?
  placeOfSupply   String?

  // Pricing
  subtotal        Decimal       @db.Decimal(12, 2)
  cgst            Decimal?      @db.Decimal(10, 2)
  sgst            Decimal?      @db.Decimal(10, 2)
  igst            Decimal?      @db.Decimal(10, 2)
  shippingCharges Decimal?      @db.Decimal(10, 2)
  roundOff        Decimal?      @db.Decimal(5, 2)
  total           Decimal       @db.Decimal(12, 2)

  // Payment
  amountPaid      Decimal       @default(0) @db.Decimal(12, 2)
  amountDue       Decimal       @db.Decimal(12, 2)
  dueDate         DateTime?

  // Files
  pdfUrl          String?

  // Timestamps
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  sentAt          DateTime?
  paidAt          DateTime?

  // Relations
  payments        Payment[]

  @@map("invoices")
  @@index([customerId])
  @@index([status])
}

// ============================================
// PAYMENTS
// ============================================

enum PaymentMethod {
  CASH
  CHEQUE
  BANK_TRANSFER
  UPI
  CARD
  OTHER
}

model Payment {
  id              String        @id @default(uuid())

  paymentNumber   String        @unique

  // Customer
  customerId      String
  customer        Customer      @relation(fields: [customerId], references: [id])

  // Invoice
  invoiceId       String?
  invoice         Invoice?      @relation(fields: [invoiceId], references: [id])

  // Payment Details
  amount          Decimal       @db.Decimal(12, 2)
  method          PaymentMethod
  referenceNumber String?

  // Bank Details (for Cheque/Transfer)
  bankName        String?
  chequeNumber    String?
  chequeDate      DateTime?

  // Status
  isCleared       Boolean       @default(false)
  clearedAt       DateTime?

  notes           String?       @db.Text

  // Timestamps
  paymentDate     DateTime      @default(now())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("payments")
  @@index([customerId])
  @@index([invoiceId])
}

// ============================================
// INVENTORY
// ============================================

enum InventoryAction {
  PURCHASE
  SALE
  PRODUCTION_USE
  ADJUSTMENT
  RETURN
}

model InventoryLog {
  id            String          @id @default(uuid())

  productId     String
  product       Product         @relation(fields: [productId], references: [id])

  action        InventoryAction
  quantity      Int
  balanceAfter  Int

  reference     String?         // Order ID, Purchase ID, etc.
  notes         String?         @db.Text

  createdAt     DateTime        @default(now())

  @@map("inventory_logs")
  @@index([productId])
}

// ============================================
// PRODUCTION
// ============================================

enum ProductionStatus {
  MATERIAL_PENDING
  CUTTING
  STITCHING
  FINISHING
  QC
  PACKING
  READY_TO_DISPATCH
  DISPATCHED
}

model Production {
  id              String            @id @default(uuid())

  productionNumber String           @unique

  // Order Reference
  orderId         String            @unique
  order           SalesOrder        @relation(fields: [orderId], references: [id])

  // Status
  status          ProductionStatus  @default(MATERIAL_PENDING)

  // Dates
  startDate       DateTime?
  expectedCompletion DateTime?
  actualCompletion DateTime?

  notes           String?           @db.Text

  // Timestamps
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@map("production")
  @@index([status])
}

// ============================================
// ACTIVITY LOG
// ============================================

enum ActivityType {
  LEAD_CREATED
  LEAD_UPDATED
  LEAD_CONTACTED
  CATALOGUE_SENT
  QUOTATION_SENT
  ORDER_CREATED
  PAYMENT_RECEIVED
  NOTE_ADDED
  CALL_MADE
  WHATSAPP_SENT
}

model Activity {
  id          String        @id @default(uuid())

  type        ActivityType
  description String        @db.Text

  // References
  leadId      String?
  lead        Lead?         @relation(fields: [leadId], references: [id])

  userId      String?
  user        User?         @relation(fields: [userId], references: [id])

  metadata    Json?         // Additional data

  createdAt   DateTime      @default(now())

  @@map("activities")
  @@index([leadId])
  @@index([userId])
}

// WhatsApp records are independent of transport acceptance; statuses come from Meta.
model WhatsappConversation {
  id String @id @default(uuid())
  phoneNumber String @unique
  customerName String
  customerId String?
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  leadId String?
  lead Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)
  lastMessage String @default("")
  lastMessageAt DateTime @default(now())
  lastInboundAt DateTime?
  unreadCount Int @default(0)
  messages WhatsappMessage[]
  @@map("whatsapp_conversations")
}
model WhatsappMessage {
  id String @id @default(uuid())
  conversationId String
  conversation WhatsappConversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  messageId String? @unique
  message String @db.Text
  direction String
  status String
  timestamp DateTime @default(now())
  statusAt DateTime?
  failure Json?
  metadata Json?
  sentBy String?
  sender User? @relation(fields: [sentBy], references: [id], onDelete: SetNull)
  relatedId String?
  messageType String @default("TEXT")
  @@index([conversationId, timestamp])
  @@map("whatsapp_messages")
}
model WhatsappStatusEvent {
  id String @id
  messageId String
  status String
  timestamp DateTime
  failure Json?
  @@index([messageId])
  @@map("whatsapp_status_events")
}
