generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  QUOTATION
  WON
  LOST
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

enum SalesOrderStatus {
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Organization {
  id                    String        @id @default(cuid())
  name                  String
  quotationSequence     Int           @default(0)
  salesOrderSequence    Int           @default(0)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  roles                 Role[]
  users                 User[]
  customers             Customer[]
  leads                 Lead[]
  products              Product[]
  quotations            Quotation[]
  salesOrders           SalesOrder[]
  auditEvents            AuditEvent[]
}

model Role {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users          User[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model User {
  id             String        @id @default(cuid())
  organizationId String
  name           String
  email          String
  passwordHash   String
  roleId         String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           Role          @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assignedLeads  Lead[]        @relation("LeadAssignee")
  auditEvents    AuditEvent[]

  @@unique([organizationId, email])
  @@index([organizationId])
}

model Customer {
  id             String        @id @default(cuid())
  organizationId String
  name           String
  companyName    String
  phone          String
  email          String
  address        String
  city           String
  state          String
  gstNumber      String?
  status         CustomerStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads          Lead[]
  quotations     Quotation[]
  salesOrders    SalesOrder[]

  @@index([organizationId])
  @@index([organizationId, companyName])
}

model Lead {
  id             String        @id @default(cuid())
  organizationId String
  customerId     String?
  name           String
  companyName    String
  phone          String
  email          String
  source         String
  requirement    String
  quantity       Int?
  status         LeadStatus    @default(NEW)
  assignedUserId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignedUser   User?         @relation("LeadAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  quotations     Quotation[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, companyName])
}

model Product {
  id             String           @id @default(cuid())
  organizationId String
  name           String
  sku            String
  category       String
  description    String
  fabric         String
  price          Decimal          @db.Decimal(12, 2)
  moq            Int
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quotationItems QuotationItem[]
  salesOrderItems SalesOrderItem[]

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([organizationId, category])
}

model Quotation {
  id              String          @id @default(cuid())
  organizationId  String
  customerId      String
  leadId          String?
  quotationNumber String
  status          QuotationStatus @default(DRAFT)
  subtotal        Decimal         @db.Decimal(12, 2)
  tax             Decimal         @db.Decimal(12, 2)
  total           Decimal         @db.Decimal(12, 2)
  validUntil      DateTime?
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer        Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lead            Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  items           QuotationItem[]
  salesOrder      SalesOrder?

  @@unique([organizationId, quotationNumber])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, customerId])
}

model QuotationItem {
  id          String    @id @default(cuid())
  quotationId String
  productId   String
  quantity    Int
  unitPrice   Decimal   @db.Decimal(12, 2)
  taxRate     Decimal   @db.Decimal(5, 2)
  lineTotal   Decimal   @db.Decimal(12, 2)
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([quotationId])
}

model SalesOrder {
  id             String           @id @default(cuid())
  organizationId String
  customerId     String
  quotationId    String?          @unique
  orderNumber    String
  status         SalesOrderStatus @default(CONFIRMED)
  subtotal       Decimal          @db.Decimal(12, 2)
  tax            Decimal          @db.Decimal(12, 2)
  total          Decimal          @db.Decimal(12, 2)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quotation      Quotation?       @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  items          SalesOrderItem[]

  @@unique([organizationId, orderNumber])
  @@index([organizationId])
  @@index([organizationId, status])
}

model SalesOrderItem {
  id           String     @id @default(cuid())
  salesOrderId String
  productId    String
  quantity     Int
  unitPrice    Decimal    @db.Decimal(12, 2)
  taxRate      Decimal    @db.Decimal(5, 2)
  lineTotal    Decimal    @db.Decimal(12, 2)
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([salesOrderId])
}

model AuditEvent {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
}
